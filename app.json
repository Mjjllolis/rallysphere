{
  "expo": {
    "name": "RallySphere",
    "slug": "rally-sphere",
    "scheme": "rallysphere",
    "version": "1.0.1",
    "orientation": "portrait",
    "icon": "./assets/Logo.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/Logo.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "experiments": {
      "typedRoutes": true
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.rallysphere.app",
      "buildNumber": "63",
      "associatedDomains": [
        "applinks:rally-sphere.web.app"
      ],
      "icon": {
        "light": "./assets/Logo.png",
        "dark": "./assets/Logo-dark.png"
      },
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      },
      "appleTeamId": "66YBRZM5J5",
      "googleServicesFile": "./firebase/GoogleService-Info.plist",
      "entitlements": {
        "com.apple.developer.devicecheck.appattest-environment": "production",
        "com.apple.developer.in-app-payments": [
          "merchant.com.rallysphere.app"
        ]
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/Logo.png",
        "backgroundColor": "#ffffff"
      },
      "package": "com.rallysphere.app",
      "versionCode": 12,
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ],
      "googleServicesFile": "./firebase/google-services.json"
    },
    "web": {
      "favicon": "./assets/Logo.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-secure-store",
        {
          "faceIDPermission": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "RallySphere uses your photo library so you can choose images from your device — for example, to set your profile picture, add a logo when creating a club, or attach a photo to an event you're posting.",
          "cameraPermission": "RallySphere uses your camera so club organizers can photograph the verification documents our payment processor requires before a club can be paid out — for example, taking a picture of a voided check or a government-issued ID and uploading it directly, instead of scanning it to your photo library first.",
          "microphonePermission": false
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "RallySphere uses your location to show events happening near you — for example, the Local feed lists only events within a distance radius you pick, so a pickup game two miles away shows up and one across the state doesn't."
        }
      ],
      "expo-video",
      "./plugins/with-firebase-sdk-version",
      "@react-native-firebase/app",
      "@react-native-firebase/app-check",
      [
        "expo-build-properties",
        {
          "ios": {
            "useFrameworks": "static",
            "deploymentTarget": "15.1"
          },
          "android": {
            "minSdkVersion": 24
          }
        }
      ]
    ],
    "owner": "ibemisha",
    "extra": {
      "router": {},
      "eas": {
        "projectId": "ee1b7bed-c9c2-4c0f-aee6-43e55c75b4d9"
      }
    }
  }
}
