# Committed non-secret Finix config for the `rally-sphere` Firebase project.
# Firebase loads this automatically on deploy, so teammates need NO shared files.
#
# All CREDENTIALS live in Google Cloud Secret Manager — never put them here.
# Manage with:  firebase functions:secrets:set <NAME>
# Secrets in use:
#   FINIX_USERNAME, FINIX_PASSWORD
#   FINIX_USERNAME_LIVE, FINIX_PASSWORD_LIVE
#   FINIX_WEBHOOK_BASIC_USER_LIVE, FINIX_WEBHOOK_BASIC_PASS_LIVE

# "true" = sandbox default, "false" = production default (staff Debug → sandbox)
TEST_MODE=false

# Public Finix identifiers (shown in the Finix dashboard — not secret)
FINIX_APPLICATION_ID=APpDynVZb6sw6D6w3PzzfyeS
